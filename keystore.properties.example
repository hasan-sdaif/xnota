# Copy to keystore.properties (gitignored) for local signed release builds.
# CI does NOT use this file: it writes its own keystore.properties from
# GitHub Secrets (AR_KEYSTORE_BASE64, AR_KEYSTORE_PASSWORD, AR_KEY_ALIAS,
# AR_KEY_PASSWORD). (see .github/workflows/build.yml).
storeFile=/absolute/path/to/xnota.keystore
storePassword=CHANGE_ME
keyAlias=xnota
keyPassword=CHANGE_ME
